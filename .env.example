# Environment Configuration for NidhiFlow
# Copy this file to .env and fill in the values

# ── Database ──
DATABASE_URL=postgresql://nidhiflow:nidhiflow_secret@localhost:5432/nidhiflow?schema=public

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ──
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-this-to-another-random-64-char-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── MinIO (S3-compatible) ──
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nidhiflow-uploads
S3_REGION=ap-south-1

# ── Email ──
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-ethereal-user@ethereal.email
SMTP_PASS=your-ethereal-password
EMAIL_FROM=noreply@nidhiflow.in

# ── App ──
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
NODE_ENV=development

# ── Admin ──
ADMIN_EMAIL=admin@nidhiflow.in
ADMIN_PASSWORD=Admin@NidhiFlow2024!
